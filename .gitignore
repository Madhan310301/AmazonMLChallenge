# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared
push_to_github.bat

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db
__MACOSX/
**/__MACOSX/

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# Python
.pythonlibs/
__pycache__/
**/__pycache__/
*.py[cod]
.venv/
venv/
*.pkl
*.tmp
.streamlit/

# Datasets (large files - exclude from git)
Dataset/
**/Dataset/
dataset/
**/dataset/
*dataset_bak*/
**/*dataset_bak*/
*_bak/
**/*_bak/
*.zip
*.tar.gz

# Entity-resolution generated state
business_entity_resolution/cache/*
!business_entity_resolution/cache/.gitkeep
business_entity_resolution/models/*
!business_entity_resolution/models/.gitkeep
business_entity_resolution/output/*
!business_entity_resolution/output/.gitkeep
