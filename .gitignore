# === Amazon ML Challenge 2026 — Business Entity Resolution ===
# This .gitignore keeps the GitHub repo clean.
# Files removed from tracking are still on your local disk.

# ── Replit / Platform Scaffold (not part of the project) ──
.replit
.replitignore
.npmrc
replit.md
artifacts/
lib/
scripts/
pnpm-lock.yaml
pnpm-workspace.yaml
package.json
tsconfig.json
tsconfig.base.json
node_modules/
main.py
pyproject.toml
uv.lock

# ── Old / Draft Reports (kept locally, removed from GitHub) ──
Build_Report_Business_Entity_Resolution.md
Documentation_template.md
Entity_Resolution_Existing_Solutions.md
NEW_EXISTING_SYSTEMS.md
Project_Build_Prompt_Entity_Resolution.md
PROJECT_PROGRESS_REPORT.md
business_entity_resolution/Documentation_template.md

# ── Root-level app.py (Streamlit dashboard lives inside business_entity_resolution/) ──
/app.py

# ── Compiled / Build Output ──
dist/
tmp/
out-tsc/
*.tsbuildinfo
.expo/
.expo-shared/
push_to_github.bat

# ── IDE / Editor Settings ──
/.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ── Misc Logs ──
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# ── System Files ──
.DS_Store
Thumbs.db
__MACOSX/
**/__MACOSX/

# ── Replit Cache ──
.cache/
.local/
.cursor/
.github/instructions/

# ── Python ──
.pythonlibs/
__pycache__/
**/__pycache__/
*.py[cod]
.venv/
venv/
*.pkl
*.tmp
.streamlit/

# ── Competition Datasets (large files — NEVER push to GitHub) ──
Dataset/
**/Dataset/
dataset/
**/dataset/
*dataset_bak*/
**/*dataset_bak*/
*_bak/
**/*_bak/
*.zip
*.tar.gz

# ── Entity-Resolution Generated State ──
business_entity_resolution/cache/*
!business_entity_resolution/cache/.gitkeep
business_entity_resolution/models/*
!business_entity_resolution/models/.gitkeep
business_entity_resolution/output/*
!business_entity_resolution/output/.gitkeep

# ── Conversation / Agent State ──
.agents/
.conversation/
